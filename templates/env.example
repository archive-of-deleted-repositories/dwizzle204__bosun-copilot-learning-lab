# Copy this file to .env in your target project and fill real values.
# Never commit .env files.

# Telegram (status notifications only)
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# Bosun GitHub backend targeting
KANBAN_BACKEND=github
GITHUB_REPOSITORY=your-org/your-repo
GITHUB_REPO=your-org/your-repo
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=your-repo

# Scope Bosun to specific labels only
BOSUN_TASK_LABELS=agent:terraform
BOSUN_ENFORCE_TASK_LABEL=true

# Executor defaults
PRIMARY_AGENT=copilot-sdk
EXECUTORS=COPILOT:GPT_4_1:100
COPILOT_TRANSPORT=sdk

# Optional custom orchestration hook script
# ORCHESTRATOR_SCRIPT=./scripts/copilot_runner.sh
